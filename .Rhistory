ggplot(carbon_filt,
aes(x = country,
y = (sum(co2, na.rm = TRUE) / 1000000),
fill = country)
) +
geom_col() +
labs( title = 'Total CO2 Emissions',
subtitle = 'CO2 in millions of tons, 1750 - 2023')
# original graph
